{
  "manifest_version": 3,
  "name": "Stable Captions",
  "version": "1.0.0",
  "description": "Replace flowing YouTube auto-captions with calm, stable caption chunks.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stable-captions@thien.fun",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Stable Captions",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/core/settings.js",
        "src/content/settings-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "world": "MAIN",
      "js": [
        "src/content/timedtext-tap.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/page-loader.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "world": "MAIN",
      "js": [
        "src/core/text-utils.js",
        "src/core/rolling-merger.js",
        "src/core/json3-parser.js",
        "src/core/cue-lookup.js",
        "src/core/chunker.js",
        "src/core/disfluency.js",
        "src/content/track-provider.js",
        "src/content/live-source.js",
        "src/content/overlay.js",
        "src/content/main.js"
      ],
      "css": [
        "src/content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/page-loader.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "src/core/*.js",
        "src/content/*.js",
        "src/content/styles.css"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
